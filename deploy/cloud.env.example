# 云端环境变量样例 —— 只放变量名和安全占位，不含任何真实密钥。
#
# 用法：
#   1. 复制为 deploy/cloud.env 仅供本机 docker compose 使用；
#   2. 抖音云上请在「密钥管理」里逐项配置，不要把本文件填上真 Key 后提交；
#   3. 代码从环境变量读取，绝不写回容器内 .env。

# ---------- 运行环境 ----------
# dev：自动生成临时令牌、默认网关 mock、测试接口默认开启。
# prod：必须提供 ADMIN_TOKEN/CLIENT_TOKEN，测试接口默认关闭。
APP_ENV=prod
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8000
LOG_LEVEL=INFO

# ---------- 管理端 / 客户端鉴权（必填，>=16 位随机串） ----------
ADMIN_TOKEN=
CLIENT_TOKEN=

# ---------- 数据 ----------
CLOUD_DATA_DIR=/app/data
# PERSONA_PATH=/app/data/persona.json

# ---------- DeepSeek（只在云端） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_MODE=auto
LLM_TIMEOUT_SECONDS=15
# 回答「现在几点」用的时区。容器默认 UTC，主播通常在东八区。
DISPLAY_TIMEZONE=Asia/Shanghai

# ---------- 房间与队列 ----------
DEFAULT_ROOM_ID=
MAX_ROOMS=50
ROOM_IDLE_TIMEOUT_SECONDS=1800
QUEUE_MAX=50
MAX_CONTEXT_ROUNDS=10
STALE_AFTER_SECONDS=3
MAX_CONCURRENT_PER_ROOM=1
# 普通评论的表演有效期（秒）：超过就不演旧弹幕
COMMENT_EXPIRES_SECONDS=8
# 礼物有效期更长，避免高价值互动被丢掉
GIFT_EXPIRES_SECONDS=30
RESULT_TIMEOUT_SECONDS=25
DEDUP_TTL_SECONDS=600
# 自动回复默认关闭；开启后新弹幕会先被念出来再回复
AUTO_REPLY=false

# ---------- 下行网关 ----------
# mock：只跑云端（可自动回执，仅限开发）；wss：自建 WebSocket（开发/备用）；douyin_cloud：正式抖音云网关
GATEWAY_MODE=douyin_cloud
GATEWAY_MOCK_AUTO_ACK=true
GATEWAY_MOCK_ACK_DELAY_SECONDS=0.5
# prod 默认禁止 mock；仅开发/临时排障才打开
ALLOW_MOCK_GATEWAY=false

# ---------- 无状态存储（平台硬要求） ----------
# prod 必须 redis；内存模式只允许 dev 或显式 ALLOW_EPHEMERAL_STATE=true
# 抖音云建议选 Redis 6（代码也兼容 Redis 5/7）；若平台是 Cluster 模式，先确认 SCAN 为全局扫描
STATE_BACKEND=redis
# 正式环境优先留空：抖音云会自动注入下面三个 DB_REDIS_* 变量并拼成 REDIS_URL。
# 显式设置 REDIS_URL 会覆盖平台注入值（本地隧道调试时才这样用）。
REDIS_URL=
# DB_REDIS_ADDRESS=10.1.1.123/3306
# DB_REDIS_ACCOUNT=default
# DB_REDIS_PASSWORD=由平台注入，不要写进仓库
# 可选：DB_REDIS_PORT / DB_REDIS_DB / DB_REDIS_TLS
ROOM_STATE_TTL_SECONDS=1800
ROOM_LOCK_TIMEOUT_SECONDS=20
ROOM_LOCK_TTL_SECONDS=60
# 临时降级开关：正式环境不要打开
ALLOW_EPHEMERAL_STATE=false

# ---------- 抖音开放平台 ----------
# 接口地址与路径以控制台最新文档为准；权限未确认时保持为空，代码会明确报错。
DOUYIN_OPENAPI_BASE_URL=
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
# 平台内容安全：弹幕 + 昵称都检测；prod 默认开启，需要上面的 app id/secret
DOUYIN_CONTENT_SECURITY_ENABLED=true
DOUYIN_CONTENT_SECURITY_BASE_URL=https://developer.toutiao.com
# true：接口不可用时丢弃事件（安全优先）；false：允许回复但强制不转语音
DOUYIN_CONTENT_SECURITY_FAIL_CLOSED=true
DOUYIN_TIMEOUT_SECONDS=10
DOUYIN_RETRIES=2
DOUYIN_TOKEN_PATH=
DOUYIN_TASK_START_PATH=
DOUYIN_TASK_STOP_PATH=
DOUYIN_TASK_STATUS_PATH=
DOUYIN_COMMAND_PUSH_PATH=
DOUYIN_COMMAND_INTERRUPT_PATH=

# ---------- 平台消息校验 ----------
# disabled 只允许用于 dev；prod 配 header 或 hmac
DOUYIN_VERIFY_MODE=hmac
DOUYIN_VERIFY_TOKEN=
DOUYIN_VERIFY_SECRET=
DOUYIN_VERIFY_TOKEN_HEADER=x-douyin-token
DOUYIN_SIGNATURE_HEADER=x-douyin-signature
DOUYIN_TIMESTAMP_HEADER=x-douyin-timestamp
DOUYIN_TIMESTAMP_TOLERANCE_SECONDS=300

# ---------- 内容安全 ----------
# 逗号分隔；命中即拒绝评论 / 替换模型回复
BLOCKED_WORDS=
MAX_COMMENT_CHARS=200
MAX_REPLY_CHARS=240

# ---------- 礼物 ID 映射（优先使用 gift_id） ----------
# 形如：giftIdA=嘉年华,giftIdB=火箭
GIFT_ID_MAP=

# ---------- 日志与隐私 ----------
# 默认 false：日志只写 event_id / command_id，不写观众昵称和弹幕文本。
# 只有在你确认平台允许、且排障确实需要时才改成 true。
LOG_VIEWER_DATA=false

# ---------- 测试接口 ----------
# 正式环境保持 false；设为 true 会暴露模拟评论/礼物、模拟循环和清空上下文
ENABLE_TEST_ENDPOINTS=false
# 仅当非常明确地需要在 prod 开测试接口时才打开（不推荐）
ALLOW_TEST_ENDPOINTS_IN_PROD=false
