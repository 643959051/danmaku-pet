# 开播电脑客户端配置样例。复制为 .env 后按需修改。
# 这里只放非敏感与连接参数：DeepSeek Key / 平台密钥只存在于抖音云，不进入本地 EXE。

# ---------- 云端连接 ----------
# 直播间房间号：由云端 / 平台确认后填写（也可用 --room-id 或平台启动参数）
ROOM_ID=
# 客户端标识，默认取主机名
CLIENT_ID=
# 云端下行地址：正式链路用抖音云网关；开发/备用用自建 WSS
CLOUD_URL=ws://127.0.0.1:8000/ws/client
# 云端 CLIENT_TOKEN（在抖音云密钥管理中配置），由启动参数或本机环境变量提供
CLIENT_TOKEN=
# websocket | static | platform
CLIENT_TRANSPORT=websocket
HEARTBEAT_INTERVAL_SECONDS=8
RECONNECT_MIN_SECONDS=1
RECONNECT_MAX_SECONDS=20
# 收到指令时允许的过期宽限（秒）
COMMAND_GRACE_SECONDS=0.5
# 本地模拟云端指令（CLIENT_TRANSPORT=static 时使用）
STATIC_COMMANDS=

# ---------- 本地状态页 ----------
APP_HOST=127.0.0.1
APP_PORT=8787
AUTO_OPEN_BROWSER=true
LOG_LEVEL=INFO

# ---------- 本地语音 / 小人 ----------
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+8%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_CACHE=true

DESKTOP_PET=true
PET_SCALE=0.8
DEFAULT_USER=观众
