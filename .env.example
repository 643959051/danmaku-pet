# Copy to .env and fill the key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# auto: use DeepSeek when a key exists, otherwise clearly-labelled local mock.
# deepseek: fail-safe startup warning + mock if the key is missing.
# mock: force local mock.
LLM_MODE=auto

APP_HOST=127.0.0.1
APP_PORT=8787
LLM_TIMEOUT_SECONDS=15
MAX_CONTEXT_ROUNDS=10
STALE_AFTER_SECONDS=3
QUEUE_MAX=50

TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+8%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_CACHE=true

DESKTOP_PET=true
# 默认关闭；开启后新弹幕会先被念出来，再回复
AUTO_REPLY=false
# 启动并监听成功后自动打开管理页面
AUTO_OPEN_BROWSER=true
PET_SCALE=0.8
DEFAULT_USER=观众
